pipeline {
    agent any
    
    environment {
        REMOTE_HOST = '13.204.143.16'
        REMOTE_USER = 'ubuntu'
        REMOTE_PATH = '/home/ubuntu/jarvis'
    }
    
    stages {
        stage('Checkout SCM') {
            steps {
                checkout scm
            }
        }
        
        stage('Verify Files') {
            steps {
                echo "Verifying repo files..."
                sh '''
                    set +e
                    ls -la
                    echo "Check for possible entrypoints:"
                    test -f wsgi.py && echo "✓ wsgi.py" || true
                    test -f main.py && echo "✓ main.py" || true
                    test -f app.py && echo "✓ app.py" || true
                    test -f requirements.txt && echo "✓ requirements.txt" || true
                    set -e
                '''
            }
        }
        
        stage('Code Quality') {
            steps {
                echo "Running flake8 on Python files..."
                sh '''
                    set +e
                    python3 -m venv .venv
                    . .venv/bin/activate
                    pip install --upgrade pip setuptools wheel
                    pip install flake8
                    find . -name "*.py" -not -path "./.venv/*" | xargs flake8 || true
                    set -e
                '''
            }
        }
        
        stage('Package & Transfer') {
            steps {
                echo "Syncing workspace to remote server using rsync..."
                sshagent(['jarvis-key']) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ${REMOTE_USER}@${REMOTE_HOST} "mkdir -p ${REMOTE_PATH}"
                        rsync -avz --delete --exclude=.git ./ ${REMOTE_USER}@${REMOTE_HOST}:${REMOTE_PATH}/
                        echo "✓ Files synced successfully."
                    """
                }
            }
        }
        
        stage('Setup Virtual Display') {
            steps {
                echo "Setting up virtual display on remote server..."
                sshagent(['jarvis-key']) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ${REMOTE_USER}@${REMOTE_HOST} "
                            # Xvfb install करा (जर नसेल तर)
                            if ! command -v Xvfb > /dev/null 2>&1; then
                                echo 'Installing Xvfb...'
                                sudo apt-get update -qq
                                sudo apt-get install -y -qq xvfb x11-utils
                            fi
                            
                            # Xvfb चालू आहे का तपासा
                            if ! pgrep -f 'Xvfb :99' > /dev/null; then
                                echo 'Starting Xvfb on display :99...'
                                pkill -f 'Xvfb' || true
                                nohup Xvfb :99 -screen 0 1024x768x16 > /dev/null 2>&1 &
                                sleep 3
                            else
                                echo 'Xvfb already running on :99'
                            fi
                            
                            # DISPLAY environment variable set करा
                            echo 'export DISPLAY=:99' >> ~/.bashrc
                            echo '✓ Virtual display setup completed'
                        "
                    """
                }
            }
        }
        
        stage('Setup Remote Environment') {
            steps {
                echo "Setting up Python environment and dependencies on remote server..."
                sshagent(['jarvis-key']) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ${REMOTE_USER}@${REMOTE_HOST} "
                            set -e
                            cd ${REMOTE_PATH}
                            
                            # DISPLAY set करा
                            export DISPLAY=:99
                            
                            # Virtual environment setup
                            if [ -d 'venv' ]; then 
                                echo 'Removing old virtual environment...'
                                rm -rf venv
                            fi
                            
                            python3 -m venv venv
                            . venv/bin/activate
                            
                            pip install --upgrade pip
                            echo 'Installing requirements...'
                            
                            if [ -f 'requirements.txt' ]; then 
                                pip install -r requirements.txt
                                echo '✓ Requirements installed successfully'
                            else
                                echo '✗ requirements.txt not found'
                                exit 1
                            fi
                        "
                    """
                }
            }
        }
        
        stage('Debug Remote') {
            steps {
                echo "Debugging remote environment..."
                sshagent(['jarvis-key']) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ${REMOTE_USER}@${REMOTE_HOST} "
                            cd ${REMOTE_PATH}
                            export DISPLAY=:99
                            
                            echo '=== Files ==='
                            ls -la
                            
                            echo '=== Jarvis Directory ==='
                            ls -la Jarvis/ || echo 'No Jarvis directory'
                            
                            echo '=== Testing Python Import ==='
                            . venv/bin/activate
                            python3 -c '
import os
import sys
print(\"Python path:\", sys.path)
print(\"DISPLAY:\", os.environ.get(\"DISPLAY\", \"Not set\"))

try:
    # Headless environment साठी pyautogui configure करा
    import pyautogui
    pyautogui.FAILSAFE = False
except Exception as e:
    print(\"PyAutoGUI config warning:\", str(e))

try:
    from Jarvis import jarvis
    print(\"SUCCESS: Jarvis import successful\")
except Exception as e:
    print(\"ERROR: Jarvis import failed -\", str(e))
    sys.exit(1)
                            '
                        "
                    """
                }
            }
        }
        
        stage('Stop Existing Service') {
            steps {
                echo "Stopping existing service or python processes..."
                sshagent(['jarvis-key']) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ${REMOTE_USER}@${REMOTE_HOST} "
                            set +e
                            # Systemd service stop करा
                            if systemctl --quiet is-active jarvis; then
                                sudo systemctl stop jarvis
                                echo '✓ Stopped jarvis service'
                            fi
                            
                            # Python processes kill करा
                            pkill -f 'python.*main.py' || true
                            pkill -f 'gunicorn' || true
                            echo '✓ Cleaned up existing processes'
                            set -e
                        "
                    """
                }
            }
        }
        
        stage('Start Application') {
            steps {
                echo "Starting the application..."
                sshagent(['jarvis-key']) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ${REMOTE_USER}@${REMOTE_HOST} "
                            cd ${REMOTE_PATH}
                            export DISPLAY=:99
                            
                            # Virtual environment activate करा
                            . venv/bin/activate
                            
                            # Headless mode साठी pyautogui configure करा
                            python3 -c '
import os
if \"DISPLAY\" not in os.environ:
    os.environ[\"DISPLAY\"] = \":99\"
try:
    import pyautogui
    pyautogui.FAILSAFE = False
except:
    pass
                            '
                            
                            echo 'Starting Jarvis application...'
                            # Background मध्ये start करा
                            nohup python3 -u main.py > jarvis.log 2>&1 &
                            
                            # Process start झाला का तपासा
                            sleep 5
                            if pgrep -f 'python.*main.py' > /dev/null; then
                                echo '✓ Jarvis application started successfully'
                                echo 'Process info:'
                                pgrep -f 'python.*main.py' | xargs ps -fp
                            else
                                echo '✗ Failed to start Jarvis application'
                                echo 'Log file content:'
                                cat jarvis.log || true
                                exit 1
                            fi
                        "
                    """
                }
            }
        }
        
        stage('Verify Deployment') {
            steps {
                echo "Verifying deployment..."
                sshagent(['jarvis-key']) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ${REMOTE_USER}@${REMOTE_HOST} "
                            cd ${REMOTE_PATH}
                            export DISPLAY=:99
                            
                            echo '=== Verification Checks ==='
                            
                            # Process running आहे का तपासा
                            echo '1. Process check:'
                            if pgrep -f 'python.*main.py' > /dev/null; then
                                echo '   ✓ Jarvis process is running'
                                pgrep -f 'python.*main.py' | xargs ps -fp --no-headers
                            else
                                echo '   ✗ Jarvis process not found'
                                exit 1
                            fi
                            
                            # Log file तपासा
                            echo '2. Log file check:'
                            if [ -f 'jarvis.log' ]; then
                                echo '   ✓ Log file exists'
                                echo '   Last 10 lines of log:'
                                tail -10 jarvis.log
                            else
                                echo '   ✗ Log file not found'
                            fi
                            
                            # Application responsive आहे का तपासा
                            echo '3. Application health check:'
                            . venv/bin/activate
                            python3 -c '
import Jarvis.jarvis
print(\"   ✓ Jarvis module loaded successfully\")
                            '
                            
                            echo '✓ All verification checks passed'
                        "
                    """
                }
            }
        }
    }
    
    post {
        always {
            echo "Pipeline execution completed"
        }
        success {
            echo "✅ DEPLOYMENT SUCCESSFUL! Jarvis is now running on ${REMOTE_HOST}"
            sh """
                echo 'Deployment Summary:'
                echo '- Code deployed to: ${REMOTE_USER}@${REMOTE_HOST}:${REMOTE_PATH}'
                echo '- Virtual display: :99'
                echo '- Application: Running in background'
                echo '- Log file: ${REMOTE_PATH}/jarvis.log'
            """
        }
        failure {
            echo "❌ DEPLOYMENT FAILED! Check the pipeline logs for details."
        }
    }
}