pipeline {
    agent any

    environment {
        REMOTE_HOST = "52.66.252.230"
        REMOTE_USER = "ubuntu"
        REMOTE_DIR = "/home/ubuntu/jarvis"
        DISPLAY = ":99"
    }

    stages {

        stage('Clone Repository') {
            steps {
                git url: 'https://github.com/dalvipiyush07/Jarvis-Desktop-Voice-Assistant.git',
                    branch: 'main'
            }
        }

        stage('Deploy Files to Server') {
            steps {
                sshagent(credentials: ['jarvis-key']) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ${REMOTE_USER}@${REMOTE_HOST} "mkdir -p ${REMOTE_DIR} && rm -rf ${REMOTE_DIR}/*"
                        scp -o StrictHostKeyChecking=no -r ./* ${REMOTE_USER}@${REMOTE_HOST}:${REMOTE_DIR}/
                    """
                }
            }
        }

        stage('Install System Dependencies') {
            steps {
                sshagent(credentials: ['jarvis-key']) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ${REMOTE_USER}@${REMOTE_HOST} '
                            sudo apt-get update -qq

                            # GUI + screenshot tools for PyAutoGUI
                            sudo apt-get install -y -qq scrot python3-tk

                            # Audio + pyaudio build tools
                            sudo apt-get install -y -qq portaudio19-dev libasound2-dev libjack-dev libpulse-dev build-essential gcc g++

                            # Text-to-speech backend
                            sudo apt-get install -y -qq espeak libespeak-dev

                            # Xvfb virtual screen
                            sudo apt-get install -y -qq xvfb x11-utils

                            # Try system pyaudio
                            sudo apt-get install -y -qq python3-pyaudio || true
                        '
                    """
                }
            }
        }

        stage('Start Virtual Display') {
            steps {
                sshagent(credentials: ['jarvis-key']) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ${REMOTE_USER}@${REMOTE_HOST} '
                            if ! pgrep -f "Xvfb :99" > /dev/null; then
                                nohup Xvfb :99 -screen 0 1024x768x16 > /dev/null 2>&1 &
                                sleep 3
                            fi
                        '
                    """
                }
            }
        }

        stage('Setup Python Environment') {
            steps {
                sshagent(credentials: ['jarvis-key']) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ${REMOTE_USER}@${REMOTE_HOST} '
                            set -e
                            cd ${REMOTE_DIR}

                            # Clean old venv and create new one
                            rm -rf venv || true
                            python3 -m venv venv
                            source venv/bin/activate

                            pip install --upgrade pip setuptools wheel

                            # Install pyaudio (attempt pip, fallback allowed)
                            pip install pyaudio || pip install --global-option="build_ext" --global-option="-I/usr/include" pyaudio || true

                            # Install other python deps
                            pip install pyautogui speechrecognition pyttsx3 requests selenium beautifulsoup4 pygame || true

                            # Verify imports using a heredoc python block WITHOUT emojis
                            echo "=== Verifying core imports ==="
                            python3 - <<'PY'
import sys
modules = [
    ("pyautogui","pyautogui"),
    ("speech_recognition","speech_recognition"),
    ("pyaudio","pyaudio"),
    ("pyttsx3","pyttsx3"),
    ("requests","requests")
]
failed = []
for name, mod in modules:
    try:
        __import__(mod)
    except Exception as e:
        failed.append((name, str(e)))

if failed:
    print("IMPORT ERRORS:", file=sys.stderr)
    for m, err in failed:
        print(" - {} : {}".format(m, err), file=sys.stderr)
    sys.exit(1)

print("ALL IMPORTS SUCCESSFUL")
sys.exit(0)
PY
                        '
                    """
                }
            }
        }

        stage('Stop Existing App') {
            steps {
                sshagent(credentials: ['jarvis-key']) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ${REMOTE_USER}@${REMOTE_HOST} '
                            pkill -f "python.*main.py" || true
                            pkill -9 -f "python.*main.py" || true
                        '
                    """
                }
            }
        }

        stage('Start Jarvis Application') {
            steps {
                sshagent(credentials: ['jarvis-key']) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ${REMOTE_USER}@${REMOTE_HOST} '
                            cd ${REMOTE_DIR}
                            export DISPLAY=${DISPLAY}
                            source venv/bin/activate

                            echo "Launching Jarvis..."
                            nohup python3 main.py > jarvis.log 2>&1 &

                            sleep 4

                            if pgrep -f "python.*main.py" > /dev/null; then
                                echo "Jarvis started successfully!"
                            else
                                echo "Jarvis failed to start"
                                tail -n 50 jarvis.log
                                exit 1
                            fi
                        '
                    """
                }
            }
        }

        stage('Verify Deployment') {
            steps {
                sshagent(credentials: ['jarvis-key']) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ${REMOTE_USER}@${REMOTE_HOST} "
                            if pgrep -f 'python.*main.py' > /dev/null; then
                                echo 'Jarvis is RUNNING'
                                tail -n 20 ${REMOTE_DIR}/jarvis.log
                            else
                                echo 'Jarvis is NOT running'
                                cat ${REMOTE_DIR}/jarvis.log
                                exit 1
                            fi
                        "
                    """
                }
            }
        }
    }

    post {
        success {
            echo 'Deployment Successful! Jarvis is LIVE.'
        }
        failure {
            echo 'Deployment Failed — check the logs above.'
        }
    }
}
