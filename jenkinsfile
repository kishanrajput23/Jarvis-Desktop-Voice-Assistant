pipeline {
    agent any
    
    environment {
        REMOTE_HOST = "65.1.130.238"
        REMOTE_USER = "ubuntu"
        REMOTE_DIR = "/home/ubuntu/jarvis"
    }
    
    stages {
        stage('Clone Repository') {
            steps {
                echo 'Cloning repository from GitHub...'
                git url: 'https://github.com/dalvipiyush07/Jarvis-Desktop-Voice-Assistant.git', 
                    branch: 'main'
            }
        }
        
        stage('Verify Files') {
            steps {
                echo 'Verifying project files...'
                sh '''
                    echo "=== Checking essential files ==="
                    ls -la
                    echo "=== main.py exists? ==="
                    test -f main.py && echo "main.py found" || echo "main.py missing"
                    echo "=== requirements.txt exists? ==="
                    test -f requirements.txt && echo "requirements.txt found" || echo "requirements.txt missing"
                    echo "=== Jarvis directory exists? ==="
                    test -d Jarvis && echo "Jarvis directory found" || echo "Jarvis directory missing"
                '''
            }
        }
        
        stage('Deploy Files') {
            steps {
                echo 'Deploying files to server...'
                sshagent(credentials: ['jarvis-key']) {
                    sh """
                        echo "=== Creating directory on server ==="
                        ssh -o StrictHostKeyChecking=no ${REMOTE_USER}@${REMOTE_HOST} "mkdir -p ${REMOTE_DIR} && rm -rf ${REMOTE_DIR}/*"
                        
                        echo "=== Copying files ==="
                        scp -o StrictHostKeyChecking=no main.py ${REMOTE_USER}@${REMOTE_HOST}:${REMOTE_DIR}/
                        scp -o StrictHostKeyChecking=no requirements.txt ${REMOTE_USER}@${REMOTE_HOST}:${REMOTE_DIR}/
                        scp -o StrictHostKeyChecking=no -r Jarvis/ ${REMOTE_USER}@${REMOTE_HOST}:${REMOTE_DIR}/
                        
                        echo "Files deployed successfully"
                    """
                }
            }
        }
        
        stage('Setup Environment') {
            steps {
                echo 'Setting up environment on server...'
                sshagent(credentials: ['jarvis-key']) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ${REMOTE_USER}@${REMOTE_HOST} '
                            set -e
                            cd ${REMOTE_DIR}
                            
                            echo "=== Checking current files on server ==="
                            pwd
                            ls -la
                            
                            echo "=== Installing system dependencies ==="
                            sudo apt-get update -qq
                            sudo apt-get install -y -qq xvfb python3-venv python3-pip portaudio19-dev espeak espeak-data
                            
                            echo "=== Setting up virtual display ==="
                            if ! pgrep -x "Xvfb" > /dev/null; then
                                echo "Starting Xvfb..."
                                nohup Xvfb :99 -screen 0 1024x768x16 > /dev/null 2>&1 &
                                sleep 3
                            else
                                echo "Xvfb is already running"
                            fi
                            
                            echo "=== Creating Python virtual environment ==="
                            rm -rf venv
                            python3 -m venv venv
                            . venv/bin/activate
                            
                            echo "=== Installing Python packages ==="
                            pip install --upgrade pip
                            
                            pip install pyttsx3==2.90
                            pip install wikipedia==1.4.0
                            pip install PyAutoGUI==0.9.54
                            pip install SpeechRecognition==3.10.4
                            pip install pyjokes==0.6.0
                            pip install pyaudio
                            
                            echo "=== Verifying core imports ==="
                            python3 -c "import pyttsx3; print('SUCCESS: pyttsx3 imported')"
                            python3 -c "import speech_recognition; print('SUCCESS: speech_recognition imported')"
                            python3 -c "import pyautogui; print('SUCCESS: pyautogui imported')"
                            python3 -c "import wikipedia; print('SUCCESS: wikipedia imported')"
                            python3 -c "import pyjokes; print('SUCCESS: pyjokes imported')"
                            
                            echo "Environment setup completed"
                        '
                    """
                }
            }
        }
        
        stage('Fix TTS Issue') {
            steps {
                echo 'Fixing TTS voice issue...'
                sshagent(credentials: ['jarvis-key']) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ${REMOTE_USER}@${REMOTE_HOST} '
                            set -e
                            cd ${REMOTE_DIR}
                            
                            echo "=== Creating fixed jarvis.py ==="
                            
                            # Create a simple Python script to generate the fixed file
                            cat > fix_jarvis.py << 'ENDOFFILE'
import os

# Read original file
with open('Jarvis/jarvis.py', 'r') as f:
    content = f.read()

# Replace the TTS initialization part
old_init = '''engine = pyttsx3.init()
voices = engine.getProperty('voices')
engine.setProperty('voice', voices[1].id)  
engine.setProperty('rate', 150)
engine.setProperty('volume', 1)'''

new_init = '''# Fixed TTS initialization with error handling
try:
    engine = pyttsx3.init()
    voices = engine.getProperty('voices')
    if voices and len(voices) > 1:
        engine.setProperty('voice', voices[1].id)  
    elif voices:
        engine.setProperty('voice', voices[0].id)
    else:
        print("Warning: No TTS voices available")
    engine.setProperty('rate', 150)
    engine.setProperty('volume', 1)
    print("TTS engine initialized successfully")
except Exception as e:
    print(f"TTS initialization failed: {e}")
    engine = None'''

# Replace in content
content = content.replace(old_init, new_init)

# Fix Linux paths and commands
content = content.replace('os.path.expanduser("~\\\\\\\\Pictures\\\\\\\\screenshot.png")', 'os.path.expanduser("~/Pictures/screenshot.png")')
content = content.replace('os.path.expanduser("~\\\\\\\\Music")', 'os.path.expanduser("~/Music")')
content = content.replace('os.startfile(', 'os.system(f"xdg-open \\\\'" + ')
content = content.replace('os.system("shutdown /s /f /t 1")', 'os.system("shutdown now")')
content = content.replace('os.system("shutdown /r /f /t 1")', 'os.system("reboot")')

# Write fixed file
with open('Jarvis/jarvis_fixed.py', 'w') as f:
    f.write(content)

print("Fixed jarvis.py created successfully")
ENDOFFILE

                            # Run the fix script
                            . venv/bin/activate
                            python3 fix_jarvis.py
                            
                            # Replace original with fixed version
                            mv Jarvis/jarvis_fixed.py Jarvis/jarvis.py
                            
                            echo "TTS fix applied successfully"
                        '
                    """
                }
            }
        }
        
        stage('Start Application') {
            steps {
                echo 'Starting Jarvis application...'
                sshagent(credentials: ['jarvis-key']) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ${REMOTE_USER}@${REMOTE_HOST} '
                            set -e
                            cd ${REMOTE_DIR}
                            
                            echo "=== Setting up X11 authentication ==="
                            touch ~/.Xauthority
                            xauth generate :99 . trusted
                            
                            echo "=== Starting Jarvis ==="
                            export DISPLAY=:99
                            . venv/bin/activate
                            
                            # Start application
                            nohup python3 main.py > jarvis.log 2>&1 &
                            
                            sleep 10
                            
                            echo "=== Checking application status ==="
                            if ps aux | grep -v grep | grep "python.*main.py" > /dev/null; then
                                echo "SUCCESS: Jarvis started successfully"
                                echo "=== Recent logs ==="
                                tail -10 jarvis.log
                            else
                                echo "ERROR: Jarvis failed to start"
                                echo "=== Error logs ==="
                                tail -20 jarvis.log
                                exit 1
                            fi
                        '
                    """
                }
            }
        }
        
        stage('Verify Deployment') {
            steps {
                echo 'Verifying deployment...'
                sshagent(credentials: ['jarvis-key']) {
                    sh """
                        sleep 10
                        ssh -o StrictHostKeyChecking=no ${REMOTE_USER}@${REMOTE_HOST} '
                            cd ${REMOTE_DIR}
                            echo "=== Final verification ==="
                            
                            if ps aux | grep -v grep | grep "python.*main.py" > /dev/null; then
                                echo "SUCCESS: DEPLOYMENT COMPLETED"
                                echo "Jarvis is running on the server"
                                echo "=== Process info ==="
                                ps aux | grep -v grep | grep "python.*main.py"
                                echo "=== Latest logs ==="
                                tail -5 jarvis.log
                            else
                                echo "ERROR: Jarvis is not running"
                                echo "=== Checking logs for errors ==="
                                tail -30 jarvis.log
                                exit 1
                            fi
                        '
                    """
                }
            }
        }
    }
    
    post {
        success {
            echo 'DEPLOYMENT COMPLETED SUCCESSFULLY!'
            echo 'Jarvis voice assistant is now running on the remote server.'
        }
        failure {
            echo 'DEPLOYMENT FAILED! Check the logs above for details.'
        }
    }
}