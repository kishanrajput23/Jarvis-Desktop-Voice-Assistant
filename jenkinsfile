pipeline {
    agent any
    
    environment {
        REMOTE_HOST = "65.1.130.238"
        REMOTE_USER = "ubuntu"
        REMOTE_DIR = "/home/ubuntu/jarvis"
    }
    
    stages {
        stage('Clone Repository') {
            steps {
                echo 'Cloning repository from GitHub...'
                git url: 'https://github.com/dalvipiyush07/Jarvis-Desktop-Voice-Assistant.git', 
                    branch: 'main'
            }
        }
        
        stage('Verify Files') {
            steps {
                echo 'Verifying project files...'
                sh '''
                    echo "=== Checking essential files ==="
                    ls -la
                    echo "=== main.py exists? ==="
                    test -f main.py && echo "main.py found" || echo "main.py missing"
                    echo "=== requirements.txt exists? ==="
                    test -f requirements.txt && echo "requirements.txt found" || echo "requirements.txt missing"
                    echo "=== Jarvis directory exists? ==="
                    test -d Jarvis && echo "Jarvis directory found" || echo "Jarvis directory missing"
                '''
            }
        }
        
        stage('Deploy Files') {
            steps {
                echo 'Deploying files to server...'
                sshagent(credentials: ['jarvis-key']) {
                    sh """
                        echo "=== Creating directory on server ==="
                        ssh -o StrictHostKeyChecking=no ${REMOTE_USER}@${REMOTE_HOST} "mkdir -p ${REMOTE_DIR} && rm -rf ${REMOTE_DIR}/*"
                        
                        echo "=== Copying files ==="
                        scp -o StrictHostKeyChecking=no main.py ${REMOTE_USER}@${REMOTE_HOST}:${REMOTE_DIR}/
                        scp -o StrictHostKeyChecking=no requirements.txt ${REMOTE_USER}@${REMOTE_HOST}:${REMOTE_DIR}/
                        scp -o StrictHostKeyChecking=no -r Jarvis/ ${REMOTE_USER}@${REMOTE_HOST}:${REMOTE_DIR}/
                        
                        echo "Files deployed successfully"
                    """
                }
            }
        }
        
        stage('Setup Environment') {
            steps {
                echo 'Setting up environment on server...'
                sshagent(credentials: ['jarvis-key']) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ${REMOTE_USER}@${REMOTE_HOST} '
                            set -e
                            cd ${REMOTE_DIR}
                            
                            echo "=== Checking current files on server ==="
                            pwd
                            ls -la
                            
                            echo "=== Installing system dependencies ==="
                            sudo apt-get update -qq
                            sudo apt-get install -y -qq xvfb python3-venv python3-pip portaudio19-dev espeak espeak-data
                            
                            echo "=== Setting up virtual display ==="
                            if ! pgrep -x "Xvfb" > /dev/null; then
                                echo "Starting Xvfb..."
                                nohup Xvfb :99 -screen 0 1024x768x16 > /dev/null 2>&1 &
                                sleep 3
                            else
                                echo "Xvfb is already running"
                            fi
                            
                            echo "=== Creating Python virtual environment ==="
                            rm -rf venv
                            python3 -m venv venv
                            . venv/bin/activate
                            
                            echo "=== Installing Python packages ==="
                            pip install --upgrade pip
                            
                            pip install pyttsx3==2.90
                            pip install wikipedia==1.4.0
                            pip install PyAutoGUI==0.9.54
                            pip install SpeechRecognition==3.10.4
                            pip install pyjokes==0.6.0
                            pip install pyaudio
                            
                            echo "=== Verifying core imports ==="
                            python3 -c "import pyttsx3; print('SUCCESS: pyttsx3 imported')"
                            python3 -c "import speech_recognition; print('SUCCESS: speech_recognition imported')"
                            python3 -c "import pyautogui; print('SUCCESS: pyautogui imported')"
                            python3 -c "import wikipedia; print('SUCCESS: wikipedia imported')"
                            python3 -c "import pyjokes; print('SUCCESS: pyjokes imported')"
                            
                            echo "Environment setup completed"
                        '
                    """
                }
            }
        }
        
        stage('Fix TTS Issue') {
            steps {
                echo 'Fixing TTS voice issue...'
                sshagent(credentials: ['jarvis-key']) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ${REMOTE_USER}@${REMOTE_HOST} '
                            set -e
                            cd ${REMOTE_DIR}
                            
                            echo "=== Applying TTS fix to jarvis.py ==="
                            
                            # Create fixed jarvis.py
                            cat > Jarvis/jarvis_fixed.py << 'EOF'
import pyttsx3
import datetime
import speech_recognition as sr
import wikipedia
import webbrowser as wb
import os
import random
import pyautogui
import pyjokes

# Fixed TTS initialization with error handling
try:
    engine = pyttsx3.init()
    voices = engine.getProperty('voices')
    if voices and len(voices) > 1:
        engine.setProperty('voice', voices[1].id)  
    elif voices:
        engine.setProperty('voice', voices[0].id)
    else:
        print("Warning: No TTS voices available")
    engine.setProperty('rate', 150)
    engine.setProperty('volume', 1)
    print("TTS engine initialized successfully")
except Exception as e:
    print(f"TTS initialization failed: {e}")
    engine = None


def speak(audio) -> None:
    if engine:
        engine.say(audio)
        engine.runAndWait()
    else:
        print(f"TTS: {audio}")


def time() -> None:
    """Tells the current time."""
    current_time = datetime.datetime.now().strftime("%I:%M:%S %p")
    speak("The current time is")
    speak(current_time)
    print("The current time is", current_time)


def date() -> None:
    """Tells the current date."""
    now = datetime.datetime.now()
    speak("The current date is")
    speak(f"{now.day} {now.strftime('%B')} {now.year}")
    print(f"The current date is {now.day}/{now.month}/{now.year}")


def wishme() -> None:
    """Greets the user based on the time of day."""
    speak("Welcome back, sir!")
    print("Welcome back, sir!")

    hour = datetime.datetime.now().hour
    if 4 <= hour < 12:
        speak("Good morning!")
        print("Good morning!")
    elif 12 <= hour < 16:
        speak("Good afternoon!")
        print("Good afternoon!")
    elif 16 <= hour < 24:
        speak("Good evening!")
        print("Good evening!")
    else:
        speak("Good night, see you tomorrow.")

    assistant_name = load_name()
    speak(f"{assistant_name} at your service. Please tell me how may I assist you.")
    print(f"{assistant_name} at your service. Please tell me how may I assist you.")


def screenshot() -> None:
    """Takes a screenshot and saves it."""
    img = pyautogui.screenshot()
    img_path = os.path.expanduser("~/Pictures/screenshot.png")
    img.save(img_path)
    speak(f"Screenshot saved as {img_path}.")
    print(f"Screenshot saved as {img_path}.")

def takecommand() -> str:
    """Takes microphone input from the user and returns it as text."""
    r = sr.Recognizer()
    with sr.Microphone() as source:
        print("Listening...")
        r.pause_threshold = 1

        try:
            audio = r.listen(source, timeout=5)  # Listen with a timeout
        except sr.WaitTimeoutError:
            speak("Timeout occurred. Please try again.")
            return None

    try:
        print("Recognizing...")
        query = r.recognize_google(audio, language="en-in")
        print(query)
        return query.lower()
    except sr.UnknownValueError:
        speak("Sorry, I did not understand that.")
        return None
    except sr.RequestError:
        speak("Speech recognition service is unavailable.")
        return None
    except Exception as e:
        speak(f"An error occurred: {e}")
        print(f"Error: {e}")
        return None

def play_music(song_name=None) -> None:
    """Plays music from the user's Music directory."""
    song_dir = os.path.expanduser("~/Music")
    if os.path.exists(song_dir):
        songs = os.listdir(song_dir)
    else:
        songs = []

    if song_name:
        songs = [song for song in songs if song_name.lower() in song.lower()]

    if songs:
        song = random.choice(songs)
        os.system(f"xdg-open '{os.path.join(song_dir, song)}'")
        speak(f"Playing {song}.")
        print(f"Playing {song}.")
    else:
        speak("No song found.")
        print("No song found.")

def set_name() -> None:
    """Sets a new name for the assistant."""
    speak("What would you like to name me?")
    name = takecommand()
    if name:
        with open("assistant_name.txt", "w") as file:
            file.write(name)
        speak(f"Alright, I will be called {name} from now on.")
    else:
        speak("Sorry, I couldn't catch that.")

def load_name() -> str:
    """Loads the assistant's name from a file, or uses a default name."""
    try:
        with open("assistant_name.txt", "r") as file:
            return file.read().strip()
    except FileNotFoundError:
        return "Jarvis"  # Default name


def search_wikipedia(query):
    """Searches Wikipedia and returns a summary."""
    try:
        speak("Searching Wikipedia...")
        result = wikipedia.summary(query, sentences=2)
        speak(result)
        print(result)
    except wikipedia.exceptions.DisambiguationError:
        speak("Multiple results found. Please be more specific.")
    except Exception:
        speak("I couldn't find anything on Wikipedia.")


if __name__ == "__main__":
    wishme()

    while True:
        query = takecommand()
        if not query:
            continue

        if "time" in query:
            time()
            
        elif "date" in query:
            date()

        elif "wikipedia" in query:
            query = query.replace("wikipedia", "").strip()
            search_wikipedia(query)

        elif "play music" in query:
            song_name = query.replace("play music", "").strip()
            play_music(song_name)

        elif "open youtube" in query:
            wb.open("youtube.com")
            
        elif "open google" in query:
            wb.open("google.com")

        elif "change your name" in query:
            set_name()

        elif "screenshot" in query:
            screenshot()
            speak("I've taken screenshot, please check it")

        elif "tell me a joke" in query:
            joke = pyjokes.get_joke()
            speak(joke)
            print(joke)

        elif "shutdown" in query:
            speak("Shutting down the system, goodbye!")
            os.system("shutdown now")
            break
            
        elif "restart" in query:
            speak("Restarting the system, please wait!")
            os.system("reboot")
            break
            
        elif "offline" in query or "exit" in query:
            speak("Going offline. Have a good day!")
            break
EOF

                            # Replace original jarvis.py with fixed version
                            mv Jarvis/jarvis_fixed.py Jarvis/jarvis.py
                            
                            echo "TTS fix applied successfully"
                        '
                    """
                }
            }
        }
        
        stage('Start Application') {
            steps {
                echo 'Starting Jarvis application...'
                sshagent(credentials: ['jarvis-key']) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ${REMOTE_USER}@${REMOTE_HOST} '
                            set -e
                            cd ${REMOTE_DIR}
                            
                            echo "=== Setting up X11 authentication ==="
                            touch ~/.Xauthority
                            xauth generate :99 . trusted
                            
                            echo "=== Starting Jarvis ==="
                            export DISPLAY=:99
                            . venv/bin/activate
                            
                            # Start application
                            nohup python3 main.py > jarvis.log 2>&1 &
                            
                            sleep 10
                            
                            echo "=== Checking application status ==="
                            if ps aux | grep -v grep | grep "python.*main.py" > /dev/null; then
                                echo "SUCCESS: Jarvis started successfully"
                                echo "=== Recent logs ==="
                                tail -10 jarvis.log
                            else
                                echo "ERROR: Jarvis failed to start"
                                echo "=== Error logs ==="
                                tail -20 jarvis.log
                                exit 1
                            fi
                        '
                    """
                }
            }
        }
        
        stage('Verify Deployment') {
            steps {
                echo 'Verifying deployment...'
                sshagent(credentials: ['jarvis-key']) {
                    sh """
                        sleep 10
                        ssh -o StrictHostKeyChecking=no ${REMOTE_USER}@${REMOTE_HOST} '
                            cd ${REMOTE_DIR}
                            echo "=== Final verification ==="
                            
                            if ps aux | grep -v grep | grep "python.*main.py" > /dev/null; then
                                echo "SUCCESS: DEPLOYMENT COMPLETED"
                                echo "Jarvis is running on the server"
                                echo "=== Process info ==="
                                ps aux | grep -v grep | grep "python.*main.py"
                                echo "=== Latest logs ==="
                                tail -5 jarvis.log
                            else
                                echo "ERROR: Jarvis is not running"
                                echo "=== Checking logs for errors ==="
                                tail -30 jarvis.log
                                exit 1
                            fi
                        '
                    """
                }
            }
        }
    }
    
    post {
        success {
            echo 'DEPLOYMENT COMPLETED SUCCESSFULLY!'
            echo 'Jarvis voice assistant is now running on the remote server.'
        }
        failure {
            echo 'DEPLOYMENT FAILED! Check the logs above for details.'
        }
    }
}