pipeline {
    agent any
    
    environment {
        REMOTE_HOST = "52.66.252.230"
        REMOTE_USER = "ubuntu"
    }
    
    stages {
        stage('Test Connection') {
            steps {
                sshagent(credentials: ['jarvis-key']) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ${REMOTE_USER}@${REMOTE_HOST} "echo 'Connection successful'"
                    """
                }
            }
        }
    }
}