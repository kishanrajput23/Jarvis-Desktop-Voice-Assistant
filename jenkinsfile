pipeline {
    agent any

    environment {
        REMOTE_HOST = "13.204.143.16"
        REMOTE_USER = "ubuntu"
        REMOTE_DIR  = "/home/ubuntu/jarvis"
        APP_PORT    = "5000"
        CRED_ID     = "jarvis-key"
    }

    stages {

        stage('Checkout') {
            steps {
                echo "Cloning repository..."
                checkout([$class: 'GitSCM',
                    branches: [[name: '*/main']],
                    userRemoteConfigs: [[url: 'https://github.com/dalvipiyush07/Jarvis-Desktop-Voice-Assistant.git']]
                ])
            }
        }

        stage('Verify Files') {
            steps {
                echo "Verifying repo files..."
                sh '''
                  ls -la
                  echo "Check for possible entrypoints:"
                  test -f wsgi.py && echo "✓ wsgi.py" || true
                  test -f main.py && echo "✓ main.py" || true
                  test -f app.py && echo "✓ app.py" || true
                  test -f requirements.txt && echo "✓ requirements.txt" || echo "✗ requirements.txt missing"
                '''
            }
        }

        stage('Code Quality') {
            steps {
                echo "Creating local venv for linters and running flake8 (non-blocking)..."
                sh '''
                    set -e
                    python3 -m venv .venv
                    . .venv/bin/activate
                    pip install --upgrade pip setuptools wheel
                    pip install flake8
                    [ -f app.py ] && flake8 app.py || echo "No app.py; skipping flake8"
                '''
            }
        }

        /* ---------------------------------------------------
             HERE IS YOUR UPDATED RSYNC PACKAGE & TRANSFER STAGE
           --------------------------------------------------- */
        stage('Package & Transfer') {
            steps {
                echo "Syncing workspace to remote server using rsync..."
                sshagent(credentials: [env.CRED_ID]) {
                    sh """
                        # Ensure remote directory exists
                        ssh -o StrictHostKeyChecking=no ${REMOTE_USER}@${REMOTE_HOST} "mkdir -p ${REMOTE_DIR}"

                        # Rsync workspace (excluding .git)
                        rsync -avz --delete --exclude='.git' \
                            ./ ${REMOTE_USER}@${REMOTE_HOST}:${REMOTE_DIR}/

                        echo "✔ Files synced successfully."
                    """
                }
            }
        }
        /* --------------------------------------------------- */

        stage('Setup remote venv & deps') {
            steps {
                echo "Setting up remote Python environment..."
                sshagent(credentials: [env.CRED_ID]) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ${REMOTE_USER}@${REMOTE_HOST} '
                            set -e
                            cd ${REMOTE_DIR}
                            [ -d venv ] && rm -rf venv
                            python3 -m venv venv
                            . venv/bin/activate
                            pip install --upgrade pip
                            if [ -f requirements.txt ]; then pip install -r requirements.txt; fi
                        '
                    """
                }
            }
        }

        stage('Stop existing service / process') {
            steps {
                echo "Stopping existing service or python processes..."
                sshagent(credentials: [env.CRED_ID]) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ${REMOTE_USER}@${REMOTE_HOST} '
                            if systemctl --quiet status jarvis; then
                                sudo systemctl stop jarvis || true
                            else
                                pkill -f "python.*(main|app|wsgi)" || true
                            fi
                        '
                    """
                }
            }
        }

        stage('Start application') {
            steps {
                echo "Starting application..."
                sshagent(credentials: [env.CRED_ID]) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ${REMOTE_USER}@${REMOTE_HOST} '
                            cd ${REMOTE_DIR}
                            . venv/bin/activate
                            if [ -f /etc/systemd/system/jarvis.service ]; then
                                sudo systemctl daemon-reload
                                sudo systemctl restart jarvis
                            else
                                nohup python3 -u main.py > app.log 2>&1 &
                            fi
                        '
                    """
                }
            }
        }

        stage('Verify') {
            steps {
                echo "Verifying remote app..."
                sshagent(credentials: [env.CRED_ID]) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ${REMOTE_USER}@${REMOTE_HOST} '
                            pgrep -f "python" >/dev/null && echo "✓ Process running" || exit 1
                            ss -tuln | grep -q ":${APP_PORT}" && echo "✓ Port listening" || exit 1
                            curl -sSf http://127.0.0.1:${APP_PORT}/ >/dev/null && echo "✓ HTTP OK" || exit 1
                        '
                    """
                }
            }
        }

        stage('Display info') {
            steps {
                sshagent(credentials: [env.CRED_ID]) {
                    sh """
                        ssh ubuntu@${REMOTE_HOST} '
                            echo "==== APP INFO ===="
                            echo "URL: http://${REMOTE_HOST}:${APP_PORT}"
                            echo "---- Last 40 logs ----"
                            tail -n 40 ${REMOTE_DIR}/app.log || echo "No logs"
                        '
                    """
                }
            }
        }
    }

    post {
        success {
            echo "SUCCESS! Service running → http://${env.REMOTE_HOST}:${env.APP_PORT}"
        }
        failure {
            echo "FAILED. Collecting logs..."
        }
    }
}
