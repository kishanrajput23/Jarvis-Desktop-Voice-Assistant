pipeline {
    agent any
    
    environment {
        REMOTE_HOST = "52.66.252.230"
        REMOTE_USER = "ubuntu"
        REMOTE_DIR = "/home/ubuntu/jarvis"
        APP_PORT = "8000"
    }
    
    stages {
        stage('Clone Repository') {
            steps {
                echo 'Cloning repository from GitHub...'
                git url: 'https://github.com/dalvipiyush07/Jarvis-Desktop-Voice-Assistant.git', 
                    branch: 'main'
            }
        }
        
        stage('Verify Files') {
            steps {
                echo 'Verifying project files...'
                sh '''
                    echo "=== Current Directory ==="
                    pwd
                    echo "=== All Files ==="
                    ls -la
                    echo "=== Python Files ==="
                    find . -name "*.py" | head -10
                '''
            }
        }
        
        stage('Deploy to Server') {
            steps {
                echo 'Deploying files to remote server...'
                sshagent(credentials: ['jarvis-key']) {
                    sh """
                        echo "Creating remote directory..."
                        ssh -o StrictHostKeyChecking=no ${REMOTE_USER}@${REMOTE_HOST} "mkdir -p ${REMOTE_DIR} && rm -rf ${REMOTE_DIR}/*" || true
                        
                        echo "Copying ALL files..."
                        scp -o StrictHostKeyChecking=no -r ./* ${REMOTE_USER}@${REMOTE_HOST}:${REMOTE_DIR}/ || echo "SCP completed"
                        
                        echo "✅ Files deployed successfully"
                    """
                }
            }
        }
        
        stage('Setup Virtual Display') {
            steps {
                echo 'Setting up virtual display on remote server...'
                sshagent(credentials: ['jarvis-key']) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ${REMOTE_USER}@${REMOTE_HOST} '
                            # Install Xvfb if not present
                            if ! command -v Xvfb > /dev/null 2>&1; then
                                echo "Installing Xvfb..."
                                sudo apt-get update -qq
                                sudo apt-get install -y -qq xvfb x11-utils
                            fi
                            
                            # Start Xvfb if not running
                            if ! pgrep -f "Xvfb :99" > /dev/null; then
                                echo "Starting Xvfb on display :99..."
                                pkill -f "Xvfb" || true
                                nohup Xvfb :99 -screen 0 1024x768x16 > /dev/null 2>&1 &
                                sleep 3
                            fi
                            
                            echo "✓ Virtual display setup completed"
                        '
                    """
                }
            }
        }
        
        stage('Install System Dependencies') {
            steps {
                echo 'Installing system dependencies for pyaudio...'
                sshagent(credentials: ['jarvis-key']) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ${REMOTE_USER}@${REMOTE_HOST} '
                            echo "=== Installing System Dependencies ==="
                            sudo apt-get update -qq
                            sudo apt-get install -y -qq \\
                                python3-dev \\
                                portaudio19-dev \\
                                libasound2-dev \\
                                libjack-dev \\
                                libpulse-dev \\
                                build-essential \\
                                gcc \\
                                g++ \\
                                alsa-utils
                            
                            echo "✅ System dependencies installed"
                        '
                    """
                }
            }
        }
        
        stage('Setup Python Environment') {
            steps {
                echo 'Setting up Python environment on remote server...'
                sshagent(credentials: ['jarvis-key']) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ${REMOTE_USER}@${REMOTE_HOST} "
                            set -e
                            cd ${REMOTE_DIR}
                            
                            echo '=== Checking for virtual environments ==='
                            ls -la | grep venv || true
                            
                            # Remove any existing venv directories
                            rm -rf venv .venv
                            
                            # Create fresh venv
                            echo '=== Creating fresh virtual environment ==='
                            python3 -m venv venv
                            
                            # Activate and install
                            . venv/bin/activate
                            
                            echo '=== Installing packages ==='
                            pip install --upgrade pip
                            pip install -r requirements.txt
                            
                            # Verify installation - FIXED QUOTES
                            echo '=== Verifying installations ==='
                            python3 -c \\\"import pyautogui, speech_recognition, pyaudio, pyttsx3, requests; print('SUCCESS: ALL imports working')\\\"
                            
                            echo '✅ Environment setup completed'
                        "
                    """
                }
            }
        }
        
        stage('Stop Existing App') {
            steps {
                echo 'Stopping existing application...'
                sshagent(credentials: ['jarvis-key']) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ${REMOTE_USER}@${REMOTE_HOST} '
                            set +e
                            sudo pkill -f "python.*main.py" || true
                            sudo pkill -f "python.*jarvis" || true
                            sleep 2
                            sudo pkill -9 -f "python.*main.py" || true
                            echo "✓ Cleaned up existing processes"
                            set -e
                        '
                    """
                }
            }
        }
        
        stage('Start Application') {
            steps {
                echo 'Starting Jarvis application...'
                sshagent(credentials: ['jarvis-key']) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ${REMOTE_USER}@${REMOTE_HOST} '
                            set -e
                            cd ${REMOTE_DIR}
                            
                            export DISPLAY=:99
                            . venv/bin/activate
                            
                            # Configure PyAutoGUI
                            python3 -c "import pyautogui; pyautogui.FAILSAFE = False; print('PyAutoGUI configured')"
                            
                            # Start application
                            echo "Starting Jarvis..."
                            nohup python3 main.py > jarvis.log 2>&1 &
                            
                            sleep 5
                            
                            # Check if running
                            if pgrep -f "python.*main.py" > /dev/null; then
                                echo "✅ Jarvis started successfully"
                                echo "PID: \$(pgrep -f 'python.*main.py')"
                            else
                                echo "❌ Failed to start Jarvis"
                                echo "=== Logs ==="
                                tail -20 jarvis.log || true
                                exit 1
                            fi
                        '
                    """
                }
            }
        }
        
        stage('Verify Deployment') {
            steps {
                echo 'Verifying deployment...'
                sshagent(credentials: ['jarvis-key']) {
                    sh """
                        sleep 10
                        ssh -o StrictHostKeyChecking=no ${REMOTE_USER}@${REMOTE_HOST} "
                            echo '=== Verification ==='
                            if pgrep -f 'python.*main.py' > /dev/null; then
                                echo '✅ Jarvis is RUNNING'
                                echo 'PID: \$(pgrep -f \"python.*main.py\")'
                                echo '=== Recent Logs ==='
                                tail -10 ${REMOTE_DIR}/jarvis.log || true
                            else
                                echo '❌ Jarvis is NOT running'
                                echo '=== Full Logs ==='
                                cat ${REMOTE_DIR}/jarvis.log || true
                                exit 1
                            fi
                        "
                    """
                }
            }
        }
    }
    
    post {
        success {
            echo '🎉 DEPLOYMENT SUCCESSFUL! Jarvis is running on remote server.'
        }
        failure {
            echo '❌ DEPLOYMENT FAILED! Check logs above.'
        }
    }
}