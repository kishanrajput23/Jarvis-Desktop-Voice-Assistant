pipeline {
    agent any

    environment {
        REMOTE_HOST = "13.204.143.16"
        REMOTE_USER = "ubuntu"
        REMOTE_DIR  = "/home/ubuntu/jarvis"
        APP_PORT    = "5000"
        CRED_ID     = "jarvis-key"
    }

    stages {

        stage('Checkout') {
            steps {
                echo "Cloning repository..."
                checkout([$class: 'GitSCM',
                    branches: [[name: '*/main']],
                    userRemoteConfigs: [[url: 'https://github.com/dalvipiyush07/Jarvis-Desktop-Voice-Assistant.git']]
                ])
            }
        }

        stage('Verify Files') {
            steps {
                echo "Verifying repo files..."
                sh '''
                  ls -la
                  echo "Check for possible entrypoints:"
                  test -f wsgi.py && echo "✓ wsgi.py" || true
                  test -f main.py && echo "✓ main.py" || true
                  test -f app.py && echo "✓ app.py" || true
                  test -f requirements.txt && echo "✓ requirements.txt" || echo "✗ requirements.txt missing"
                '''
            }
        }

        stage('Code Quality') {
            steps {
                echo "Running flake8 on Python files..."
                sh '''
                    set -e
                    python3 -m venv .venv
                    . .venv/bin/activate
                    pip install --upgrade pip setuptools wheel
                    pip install flake8
                    # Check all Python files, not just app.py
                    find . -name "*.py" -not -path "./.venv/*" | xargs flake8 || true
                '''
            }
        }

        stage('Package & Transfer') {
            steps {
                echo "Syncing workspace to remote server using rsync..."
                sshagent(credentials: [env.CRED_ID]) {
                    sh """
                        # Ensure remote directory exists
                        ssh -o StrictHostKeyChecking=no ${REMOTE_USER}@${REMOTE_HOST} "mkdir -p ${REMOTE_DIR}"

                        # Rsync workspace (excluding .git)
                        rsync -avz --delete --exclude='.git' \
                            ./ ${REMOTE_USER}@${REMOTE_HOST}:${REMOTE_DIR}/

                        echo "✔ Files synced successfully."
                    """
                }
            }
        }

        stage('Setup remote venv & deps') {
            steps {
                sshagent(credentials: [env.CRED_ID]) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ${REMOTE_USER}@${REMOTE_HOST} '
                            set -e
                            cd ${REMOTE_DIR}
                            [ -d venv ] && rm -rf venv
                            python3 -m venv venv
                            . venv/bin/activate
                            pip install --upgrade pip
                            echo "Installing requirements..."
                            if [ -f requirements.txt ]; then 
                                pip install -r requirements.txt
                                echo "✓ Requirements installed"
                            else
                                echo "✗ requirements.txt not found"
                                exit 1
                            fi
                        '
                    """
                }
            }
        }

        stage('Debug Remote') {
            steps {
                sshagent(credentials: [env.CRED_ID]) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ${REMOTE_USER}@${REMOTE_HOST} '
                            cd ${REMOTE_DIR}
                            echo "=== Files ==="
                            ls -la
                            echo "=== Jarvis directory ==="  
                            ls -la Jarvis/ || echo "No Jarvis directory"
                            echo "=== Requirements ==="
                            cat requirements.txt || echo "No requirements.txt"
                            echo "=== Testing Python import ==="
                            . venv/bin/activate
                            python3 -c "import sys; print('Python path:', sys.path); from Jarvis import jarvis; print('✓ Jarvis import successful')" || echo "✗ Jarvis import failed"
                        '
                    """
                }
            }
        }

        stage('Stop existing service / process') {
            steps {
                echo "Stopping existing service or python processes..."
                sshagent(credentials: [env.CRED_ID]) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ${REMOTE_USER}@${REMOTE_HOST} '
                            if systemctl --quiet status jarvis; then
                                sudo systemctl stop jarvis || true
                            else
                                pkill -f "python.*(main|app|wsgi)" || true
                            fi
                        '
                    """
                }
            }
        }

        stage('Start application') {
            steps {
                echo "Starting application..."
                sshagent(credentials: [env.CRED_ID]) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ${REMOTE_USER}@${REMOTE_HOST} '
                            cd ${REMOTE_DIR}
                            . venv/bin/activate
                            if [ -f /etc/systemd/system/jarvis.service ]; then
                                sudo systemctl daemon-reload
                                sudo systemctl restart jarvis
                            else
                                echo "Starting main.py..."
                                nohup python3 -u main.py > app.log 2>&1 &
                                echo "✓ Application started with PID: \$!"
                            fi
                        '
                    """
                }
            }
        }

        stage('Verify') {
            steps {
                echo "Verifying remote app..."
                sshagent(credentials: [env.CRED_ID]) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ${REMOTE_USER}@${REMOTE_HOST} '
                            echo "=== Process check ==="
                            pgrep -f "python.*main.py" && echo "✓ Process running" || echo "✗ Process not found"
                            echo "=== Port check ==="
                            ss -tuln | grep -q ":${APP_PORT}" && echo "✓ Port ${APP_PORT} listening" || echo "✗ Port ${APP_PORT} not listening"
                            echo "=== Log check ==="
                            tail -5 app.log || echo "No logs yet"
                        '
                    """
                }
            }
        }

        stage('Display info') {
            steps {
                sshagent(credentials: [env.CRED_ID]) {
                    sh """
                        ssh ubuntu@${REMOTE_HOST} '
                            echo "==== APP INFO ===="
                            echo "Remote Host: ${REMOTE_HOST}"
                            echo "Target Port: ${APP_PORT}"
                            echo "---- Last 40 logs ----"
                            tail -n 40 ${REMOTE_DIR}/app.log || echo "No logs found"
                            echo "---- Running Python processes ----"
                            ps aux | grep python | grep -v grep || echo "No Python processes running"
                        '
                    """
                }
            }
        }
    }

    post {
        success {
            echo "SUCCESS! Deployment completed → ${env.REMOTE_HOST}"
        }
        failure {
            echo "FAILED. Check the debug stage output for details."
        }
    }
}